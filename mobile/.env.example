# Cấu hình địa chỉ API Backend cho ứng dụng di động Reliva
# Expo Go tự nhận IP LAN qua Metro nếu EXPO_PUBLIC_API_BASE_URL được để trống.
# Nếu tự đặt địa chỉ cho điện thoại thật, dùng IPv4 Wi-Fi của máy tính (`ipconfig` trên Windows).

# 1. Expo Go trên điện thoại thật tự nhận IP máy tính từ Metro khi dùng cùng Wi-Fi.
# Chỉ đặt biến này nếu cần ghi đè địa chỉ tự nhận diện:
# EXPO_PUBLIC_API_BASE_URL=http://<IP_MAY_TINH>:8080/api/v1

# 2. Chạy trên Android Emulator (máy ảo Android Studio):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# 3. Chạy trên iOS Simulator hoặc Web:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1

# 4. Khi điện thoại dùng 4G/3G hoặc khác mạng (dùng Cloudflare Tunnel / ngrok):
# EXPO_PUBLIC_API_BASE_URL=https://<your-subdomain>.ngrok-free.app/api/v1

# The Web OAuth client ID is sent to Google for a native ID token and must be in the backend allow-list.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# For iOS, also set the iOS OAuth client ID for the app's bundle identifier.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Android also needs an Android OAuth client in Google Cloud Console, registered with
# package com.disasterrelief.c48mobile and the SHA-1 fingerprint of the app signing key.
# Its client ID is not passed from the app; the Web client above is used to request the ID token.
