{
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    {
      "name": "XeLaTeX (2 lượt để cập nhật danh mục)",
      "tools": [
        "xelatex-report",
        "xelatex-report"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex-report",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "%DOC%"
      ],
      "env": {
        "TEXMFHOME": "/home/soang/.local/share/c48-tex/texmf",
        "TEXMFVAR": "/home/soang/.local/share/c48-tex/texmf-var",
        "TEXMFCONFIG": "/home/soang/.local/share/c48-tex/texmf-config"
      }
    }
  ]
}
