# Browser key for Maps JavaScript API and Places API (New).
# Restrict this key to the web application's HTTP referrers and these APIs.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# Default vector map: OpenFreeMap Liberty. Override with another MapLibre style URL if needed.
VITE_OPENFREEMAP_STYLE_URL=

# Optional raster override for organizations with their own permitted tile endpoint.
# When set, this replaces the OpenFreeMap vector layer.
VITE_OSM_TILE_URL=
# Add the provider's required attribution if you change the tile endpoint.
VITE_OSM_TILE_ATTRIBUTION=
