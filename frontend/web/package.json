{
  "name": "@c48/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" index.html",
    "contracts:generate": "openapi-typescript ../../contracts/openapi/identity.json -o src/api/generated/identity.ts && openapi-typescript ../../contracts/openapi/response.json -o src/api/generated/response.ts && openapi-typescript ../../contracts/openapi/logistics.json -o src/api/generated/logistics.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.7",
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
