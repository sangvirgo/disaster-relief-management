#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/../dev/lib.sh"
require_env_file
load_backend_env
require_nonproduction_env
cd "$ROOT/backend"

if [[ $# -ne 1 || "$1" != "--after-reset" ]]; then
  printf 'This check runs migrations down on the primary C48 databases. Pass --after-reset only after a primary-volume reset and migration.\n' >&2
  exit 2
fi

port="${POSTGRES_HOST_PORT:-55432}"
run_migration() {
  local service="$1" password="$2" direction="${3:-up}" url user
  case "$service" in
    identity) user=identity_migrator ;;
    response) user=response_migrator ;;
    logistics) user=logistics_migrator ;;
  esac
  url="postgresql://${user}:${password}@127.0.0.1:${port}/c48_${service}"
  if [[ "$direction" == down ]]; then
    DATABASE_URL="$url" node "$ROOT/backend/dist/apps/$service/src/database/migrate.js" down
  else
    DATABASE_URL="$url" node "$ROOT/backend/dist/apps/$service/src/database/migrate.js"
  fi
}

query() {
  local service="$1" sql="$2"
  main_compose exec -T postgres psql -XAt -v ON_ERROR_STOP=1 -U postgres -d "c48_$service" -c "$sql"
}

assert_no_application_rows() {
  local service="$1"
  main_compose exec -T postgres psql -X -v ON_ERROR_STOP=1 -U postgres -d "c48_$service" <<'SQL'
DO $c48_guard$
DECLARE
  item record;
  has_rows boolean;
BEGIN
  FOR item IN
    SELECT n.nspname, c.relname
    FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE n.nspname = 'public'
      AND c.relkind IN ('r', 'p', 'f')
      AND c.relname NOT IN ('typeorm_migrations', 'typeorm_migrations_id_seq')
      AND NOT EXISTS (
        SELECT 1 FROM pg_depend d
        WHERE d.classid = 'pg_class'::regclass AND d.objid = c.oid AND d.deptype = 'e'
      )
  LOOP
    EXECUTE format('SELECT EXISTS (SELECT 1 FROM %I.%I LIMIT 1)', item.nspname, item.relname) INTO has_rows;
    IF has_rows THEN
      RAISE EXCEPTION 'Refusing migration rollback: public table %.% contains application rows', item.nspname, item.relname;
    END IF;
  END LOOP;
END
$c48_guard$;
SQL
}

# Check every primary database before the first migration is reverted. This prevents a
# later populated database from failing after an earlier service schema has been dropped.
declare -A expected_counts=()
for service in identity response logistics; do
  assert_no_application_rows "$service"
  tracker_exists="$(query "$service" "SELECT to_regclass('public.typeorm_migrations') IS NOT NULL")"
  [[ "$tracker_exists" == "t" ]] || { printf 'FAIL %s has no primary migration history; run reset and migration first\n' "$service" >&2; exit 1; }
  applied="$(query "$service" 'SELECT count(*) FROM public.typeorm_migrations')"
  [[ "$applied" =~ ^[1-9][0-9]*$ ]] || { printf 'FAIL %s has no applied primary migrations\n' "$service" >&2; exit 1; }
  expected_counts["$service"]="$applied"
done

for service in identity response logistics; do
  case "$service" in
    identity) password="$IDENTITY_MIGRATOR_PASSWORD" ;;
    response) password="$RESPONSE_MIGRATOR_PASSWORD" ;;
    logistics) password="$LOGISTICS_MIGRATOR_PASSWORD" ;;
  esac
  down_runs="${expected_counts[$service]}"

  for ((run = 0; run < down_runs; run++)); do
    latest="$(query "$service" 'SELECT name FROM public.typeorm_migrations ORDER BY timestamp DESC, id DESC LIMIT 1')"
    before_count="$(query "$service" 'SELECT count(*) FROM public.typeorm_migrations')"
    run_migration "$service" "$password" down
    remaining_migrations="$(query "$service" 'SELECT count(*) FROM public.typeorm_migrations')"
    expected_remaining=$((before_count - 1))
    [[ "$remaining_migrations" == "$expected_remaining" ]] || { printf 'FAIL %s rollback of %s did not remove exactly one migration\n' "$service" "$latest" >&2; exit 1; }

    if [[ "$service" == identity && "$latest" == AddCampaignCoordinatorRole1794960000000 ]]; then
      role_constraint_count="$(query identity "SELECT count(*) FROM pg_constraint WHERE conrelid='public.role_grant'::regclass AND contype='c' AND pg_get_constraintdef(oid) LIKE '%CAMPAIGN_COORDINATOR%'")"
      [[ "$role_constraint_count" == "0" ]] || { echo 'FAIL campaign coordinator rollback left the role in an Identity check constraint' >&2; exit 1; }
    fi
    if [[ "$service" == identity && "$latest" == RetireLegacyStaffRoles1795046400000 ]]; then
      restored_legacy_roles="$(query identity "SELECT count(*) FROM pg_constraint WHERE conrelid='public.role_grant'::regclass AND contype='c' AND pg_get_constraintdef(oid) LIKE '%CAMPAIGN_MANAGER%' AND pg_get_constraintdef(oid) LIKE '%DISTRIBUTION_STAFF%'")"
      [[ "$restored_legacy_roles" == "1" ]] || { echo 'FAIL retired staff role rollback did not restore the legacy role catalog' >&2; exit 1; }
    fi
    if [[ "$service" == response && "$latest" == AddCampaignEngagementAndSpatialMatching1794960000000 ]]; then
      engagement_table="$(query response "SELECT to_regclass('public.campaign_engagement') IS NULL")"
      spatial_columns="$(query response "SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND ((table_name='campaign' AND column_name IN ('center','radius_m')) OR (table_name='assistance_request' AND column_name IN ('campaign_match_state','campaign_candidate_ids')))")"
      [[ "$engagement_table" == "t" && "$spatial_columns" == "0" ]] || { echo 'FAIL campaign engagement/spatial rollback left its schema delta' >&2; exit 1; }
    fi
    if [[ "$service" == response && "$latest" == AddAiAdvisory1792953600001 ]]; then
      ai_tables="$(query response "SELECT count(*) FROM information_schema.tables WHERE table_schema='public' AND table_name IN ('ai_advisory','ai_daily_usage')")"
      [[ "$ai_tables" == "0" ]] || { echo 'FAIL AI advisory rollback left AI tables' >&2; exit 1; }
    fi
    if [[ "$service" == response && "$latest" == AddSosFactsAndMissionKind1792953600000 ]]; then
      rescue_count="$(query response "SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND ((table_name='assistance_request' AND column_name IN ('needs_rescue','needs_relief_supplies')) OR (table_name='request_subject' AND column_name IN ('children_count','elderly_count')) OR (table_name='mission' AND column_name IN ('mission_kind','distribution_id')))")"
      [[ "$rescue_count" == "0" ]] || { echo 'FAIL SOS facts rollback left migrated columns' >&2; exit 1; }
    fi
    if [[ "$service" == response && "$latest" == AddEvidenceUploadIpQuota1710000000002 ]]; then
      index_count="$(query response "SELECT count(*) FROM pg_class WHERE relname='evidence_upload_ip_created_idx'")"
      column_count="$(query response "SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name='evidence_metadata' AND column_name='upload_source_ip_hash'")"
      cleanup_index_count="$(query response "SELECT count(*) FROM pg_class WHERE relname='evidence_cleanup_pending_idx'")"
      cleanup_column_count="$(query response "SELECT count(*) FROM information_schema.columns WHERE table_schema='public' AND table_name='evidence_metadata' AND column_name='cleanup_completed_at'")"
      [[ "$index_count" == "0" && "$column_count" == "0" && "$cleanup_index_count" == "0" && "$cleanup_column_count" == "0" ]] || { echo 'FAIL evidence storage rollback left its schema delta' >&2; exit 1; }
    fi
    if [[ "$service" == response && "$latest" == AddRequestSourceIpIndex1710000000001 ]]; then
      index_count="$(query response "SELECT count(*) FROM pg_class WHERE relname='request_source_ip_idx'")"
      [[ "$index_count" == "0" ]] || { echo 'FAIL request source IP rollback left request_source_ip_idx' >&2; exit 1; }
    fi
  done

  remaining="$(query "$service" "SELECT count(*) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p','v','m','f','S') AND c.relname NOT IN ('typeorm_migrations', 'typeorm_migrations_id_seq') AND NOT EXISTS (SELECT 1 FROM pg_depend d WHERE d.classid='pg_class'::regclass AND d.objid=c.oid AND d.deptype='e')")"
  [[ "$remaining" == "0" ]] || { printf 'FAIL %s down left %s public objects in the primary database\n' "$service" "$remaining" >&2; exit 1; }

  run_migration "$service" "$password"
  applied="$(query "$service" 'SELECT count(*) FROM public.typeorm_migrations')"
  expected="${expected_counts[$service]}"
  [[ "$applied" == "$expected" ]] || { printf 'FAIL %s expected %s applied migrations, got %s\n' "$service" "$expected" "$applied" >&2; exit 1; }
  if [[ "$service" == identity ]]; then
    retired_roles="$(query identity "SELECT count(*) FROM pg_constraint WHERE conrelid='public.role_grant'::regclass AND contype='c' AND pg_get_constraintdef(oid) LIKE '%CAMPAIGN_MANAGER%'")"
    [[ "$retired_roles" == "0" ]] || { echo 'FAIL identity up migration left retired staff roles in the role_grant check constraint' >&2; exit 1; }
  fi
  printf 'PASS %s primary database migration down/up\n' "$service"
done
