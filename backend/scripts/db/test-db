#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/../dev/lib.sh"
C48_TEST_PROJECT="c48-test-$$"
export C48_TEST_PROJECT
RESPONSE_TEST_JWT_PRIVATE_KEY="$(base64 -w0 "$ROOT/backend/test/fixtures/response-test-private.pem")"
export RESPONSE_TEST_JWT_PRIVATE_KEY
cleanup() {
  test_compose down --volumes --remove-orphans >/dev/null 2>&1 || true
}
trap cleanup EXIT

test_compose up -d --wait --wait-timeout 90 postgres
test_compose up -d db-init
test_compose build identity-migrate response-migrate logistics-migrate
for service in identity response logistics; do
  test_compose run --rm --no-deps "$service-migrate"
done

C48_TEST_PROJECT="$C48_TEST_PROJECT" "$ROOT/backend/scripts/db/check-schema-dump"
test_compose run --rm --no-deps idempotency-test
C48_TEST_PROJECT="$C48_TEST_PROJECT" "$ROOT/backend/scripts/db/check-migration-down"
test_compose exec -T postgres bash /test/scripts/proofs/prove-migrated-race.sh
test_compose exec -T postgres bash /test/scripts/proofs/prove-cycle-fence.sh

for service in identity response logistics; do
  test_compose exec -T -w /schema postgres psql -X -v ON_ERROR_STOP=1 -U postgres -d "c48_$service" \
    -f "/schema/test-$service.sql"
done

test_compose exec -T -e PGPORT=5432 -e PGPASSWORD=test-only postgres bash /schema/race-tests-response.sh
test_compose exec -T -e PGPORT=5432 -e PGPASSWORD=test-only postgres bash /schema/race-tests-logistics.sh
test_compose run --rm auth-test
test_compose run --rm identity-admin-test
if ! test_compose up -d --wait --wait-timeout 60 identity-api response-api logistics-api nginx; then
  printf 'API startup failed; recent service logs follow:\n' >&2
  test_compose ps -a >&2 || true
  test_compose logs --no-color --tail=120 logistics-api 2>&1 >&2 || true
  test_compose logs --no-color --tail=100 identity-api response-api nginx postgres 2>&1 >&2 || true
  exit 1
fi
test_compose stop identity-api
test_compose run --rm --no-deps response-intake-test
test_compose up -d --wait --wait-timeout 60 identity-api
test_compose up -d --wait --wait-timeout 60 response-t5-api response-storage-down-api
test_compose run --rm --no-deps response-t5-test
test_compose run --rm --no-deps response-t6-test
if ! test_compose run --rm --no-deps response-t7-test; then
  printf 'Response T7 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 response-t5-api >&2
  exit 1
fi
if ! test_compose run --rm --no-deps response-t8-test; then
  printf 'Response T8/T9 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 response-t5-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps response-t8-test node scripts/smoke/test-response-t10.mjs; then
  printf 'Response T10 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 response-t5-api >&2
  printf 'Recent Identity API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps logistics-t11-test; then
  printf 'Logistics T11 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  printf 'Recent Identity API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps logistics-t11-test node scripts/smoke/test-logistics-t12.mjs; then
  printf 'Logistics T12 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  printf 'Recent Identity API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps logistics-t11-test node scripts/smoke/test-logistics-t13.mjs; then
  printf 'Logistics T13 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  printf 'Recent Identity API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps logistics-t11-test node scripts/smoke/test-logistics-t14.mjs; then
  printf 'Logistics T14 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  printf 'Recent Identity API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  printf 'Recent Response API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 response-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
if ! test_compose run --rm --no-deps logistics-t11-test node scripts/smoke/test-logistics-t15.mjs; then
  printf 'Logistics T15 failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  test_compose logs --no-color --tail=100 identity-api >&2
  test_compose logs --no-color --tail=100 response-api >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
test_compose stop identity-api
if ! test_compose run --rm --no-deps logistics-t11-test node scripts/smoke/test-logistics-t12.mjs --identity-down; then
  printf 'Logistics T12 guest-with-Identity-down check failed; recent API logs follow:\n' >&2
  test_compose logs --no-color --tail=100 logistics-api >&2
  printf 'Recent PostgreSQL logs follow:\n' >&2
  test_compose logs --no-color --tail=200 postgres >&2
  exit 1
fi
test_compose up -d --wait --wait-timeout 60 identity-api
echo "Backend database checks passed."
