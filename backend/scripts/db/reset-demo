#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/../dev/lib.sh"
require_env_file
require_nonproduction_env

if [[ $# -ne 1 || "$1" != "--reset" ]]; then
  printf 'Usage: scripts/db/reset-demo --reset\n' >&2
  printf 'This removes only c48_pgdata, then migrates and reseeds the primary C48 databases. MinIO data is preserved.\n' >&2
  exit 2
fi

read -r -p 'This replaces the primary C48 database contents and reseeds demo data. Type c48-reset to continue: ' answer
[[ "$answer" == "c48-reset" ]] || { echo 'Reset cancelled.'; exit 1; }

bash "$ROOT/backend/scripts/db/reset-primary-databases" --reset
bash "$ROOT/backend/scripts/db/migrate"
bash "$ROOT/backend/scripts/db/seed"
bash "$ROOT/backend/scripts/dev/up"
