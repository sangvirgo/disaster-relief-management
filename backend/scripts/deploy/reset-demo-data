#!/usr/bin/env bash
# Wipe the PostgreSQL data on the AWS host and load the demo seed again.
#
#   reset-demo-data --reset [--purge-evidence]
#
# With --purge-evidence the two evidence buckets (S3_RESPONSE_BUCKET, S3_LOGISTICS_BUCKET) are emptied after the database
# has been rebuilt, so no orphaned photo outlives its record. The backup bucket is never touched.
#
# For the demo deployment, whose data is synthetic seed data. Sequence (no hostname prompt since 2026-11-25, on request): take a
# verified safety dump, stop the stack, remove ONLY the c48_pgdata volume, recreate the databases, migrate, seed, start
# the stack and check health. It never touches the MinIO volume, and it leaves S3 objects alone unless
# --purge-evidence is given (then the evidence files would otherwise stay behind as orphans). Run it as root (`sudo -i`): backend/.env is mode 600.
#
# Why not scripts/db/reset-demo: that script refuses production on purpose and ends by starting MinIO and building
# images locally, none of which belongs on this host.
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=../dev/lib.sh
source "$SCRIPT_DIR/../dev/lib.sh"

STATE_DIR="${C48_STATE_DIR:-/var/lib/c48}"
HEALTH_TIMEOUT_S="${C48_HEALTH_TIMEOUT_S:-180}"
RUN_SERVICES=(identity-api response-api logistics-api web nginx)
ENV_FILE="$ROOT/backend/.env"

log() { printf '%s [reset-demo-data] %s\n' "$(date -u +%FT%TZ)" "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }

usage() {
  cat >&2 <<'USAGE'
Usage: backend/scripts/deploy/reset-demo-data --reset [--purge-evidence]

--purge-evidence also deletes every object in the response and logistics evidence buckets (not the backup bucket).

Deletes ALL data in the three C48 databases and reseeds the demo data. A verified dump of the current data is kept in
/var/lib/c48/pre-reset (latest only). Asks you to choose the password that every demo
account will share (or set SEED_PASSWORD in the environment or in backend/.env, at least 12 characters).
USAGE
  exit 2
}

AWS_BIN="${C48_AWS_BIN:-aws}"
PURGE=0

env_value() { awk -F= -v key="$1" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$ENV_FILE"; }

safety_dump() { # same verification as the release pre-deploy dump, kept apart in pre-reset/ (latest only)
  if ! main_compose ps --status running --services 2>/dev/null | grep -qx postgres; then
    log 'postgres is not running: no safety dump (nothing to lose)'
    return 0
  fi
  local work="$STATE_DIR/pre-reset.new" database
  rm -rf "$work"; mkdir -p -m 700 "$STATE_DIR" && mkdir -m 700 "$work" || return 1
  for database in c48_identity c48_response c48_logistics; do
    main_compose exec -T postgres pg_dump --username=postgres --format=custom --dbname "$database" > "$work/$database.dump" || return 1
    main_compose exec -T postgres pg_restore --list < "$work/$database.dump" >/dev/null || return 1
  done
  (cd "$work" && sha256sum ./*.dump > manifest.sha256) || return 1
  printf 'created_utc=%s\n' "$(date -u +%FT%TZ)" > "$work/manifest.txt" || return 1
  rm -rf "$STATE_DIR/pre-reset.old"
  if [[ -d "$STATE_DIR/pre-reset" ]]; then mv "$STATE_DIR/pre-reset" "$STATE_DIR/pre-reset.old" || return 1; fi
  mv "$work" "$STATE_DIR/pre-reset" || return 1
  rm -rf "$STATE_DIR/pre-reset.old"
  log "safety dump verified in $STATE_DIR/pre-reset"
}

wait_healthy() {
  local deadline=$((SECONDS + HEALTH_TIMEOUT_S)) public_port url
  public_port="$(env_value PUBLIC_PORT)"; public_port="${public_port:-8080}"
  for url in "http://127.0.0.1:3001/health/ready" "http://127.0.0.1:3002/health/ready" \
             "http://127.0.0.1:3003/health/ready" "http://127.0.0.1:${public_port}/health/live"; do
    until curl -fsS --max-time 5 "$url" >/dev/null 2>&1; do
      (( SECONDS < deadline )) || { log "health check failed: $url"; return 1; }
      sleep 3
    done
  done
  log 'all health checks passed'
}

purge_evidence() {
  local region backup bucket name
  region="$(env_value S3_REGION)"; backup="$(env_value S3_BACKUP_BUCKET)"
  for name in S3_RESPONSE_BUCKET S3_LOGISTICS_BUCKET; do
    bucket="$(env_value "$name")"
    [[ -n "$bucket" && -n "$region" ]] || die "$name or S3_REGION is empty in backend/.env: the evidence was not purged"
    [[ "$bucket" != "$backup" ]] || die "$name equals the backup bucket: refusing to purge"
    log "emptying s3://$bucket"
    "$AWS_BIN" --region "$region" s3 rm "s3://$bucket/" --recursive --only-show-errors || die "could not empty $bucket (the database reset itself is complete)"
  done
  log 'evidence buckets emptied'
}

restart_optional_profiles() { # monitoring and the AI fallback come back as release left them; never fails the reset
  if [[ "$(env_value C48_OBSERVABILITY)" == on ]]; then
    main_compose --profile observability up --no-build -d prometheus alertmanager node-exporter postgres-exporter grafana \
      && log 'observability profile is up' || log 'WARNING: the observability profile did not start again'
  fi
  if [[ "$(env_value C48_AI_FALLBACK)" == on ]]; then
    main_compose --profile ai-fallback up --no-build -d ollama && log 'AI fallback is up' || log 'WARNING: the AI fallback did not start again'
  fi
}

main() {
  if [[ $# -eq 2 && "${2:-}" == --purge-evidence ]]; then PURGE=1; set -- "$1"; fi
  [[ $# -eq 1 && "${1:-}" == --reset ]] || usage
  [[ -r "$ENV_FILE" ]] || die 'cannot read backend/.env (run as root: sudo -i)'

  printf 'This DELETES every row in the C48 identity, response and logistics databases on this host and reloads the demo seed.\n'
  if [[ $PURGE -eq 1 ]]; then printf 'The response and logistics EVIDENCE BUCKETS will be emptied too (every photo and video). The backup bucket is not touched.\n'
  else printf 'MinIO/S3 objects are not touched (add --purge-evidence to empty the evidence buckets). A verified dump of the current data is kept in %s/pre-reset.\n' "$STATE_DIR"; fi
  [[ $PURGE -eq 0 ]] || printf 'A verified dump of the current data is kept in %s/pre-reset.\n' "$STATE_DIR"

  SEED_PASSWORD="${SEED_PASSWORD:-$(env_value SEED_PASSWORD)}" # the non-interactive reset takes it from backend/.env
  if [[ -z "${SEED_PASSWORD:-}" ]]; then
    # `|| true`: a closed stdin (the GitHub Actions button runs this through SSM) must reach the clear error below.
    read -rs -p 'Password shared by every demo account (at least 12 characters): ' SEED_PASSWORD || true
    printf '\n'
  fi
  [[ ${#SEED_PASSWORD} -ge 12 ]] || die 'the demo password must have at least 12 characters; nothing was changed'

  mkdir -p -m 700 "$STATE_DIR"
  exec 9>"$STATE_DIR/release.lock"
  flock -n 9 || die 'a release, rollback or reset is already running'

  safety_dump || die 'the safety dump failed; nothing was deleted'

  log 'stopping the stack (containers only)'
  # The optional profiles are named so their containers stop too (they share the network); started again below.
  main_compose --profile observability --profile ai-fallback down
  if docker volume inspect c48_pgdata >/dev/null 2>&1; then
    log 'removing the c48_pgdata volume'
    docker volume rm c48_pgdata
  fi

  log 'recreating the databases'
  main_compose_up -d --wait --wait-timeout 90 postgres
  main_compose_up --exit-code-from db-init db-init
  bash "$ROOT/backend/scripts/db/migrate"

  log 'seeding the demo data'
  # The seed refuses NODE_ENV=production and the services accept only development, test or production, so the override
  # applies to this one command and is never exported or written to backend/.env.
  NODE_ENV=development SEED_PASSWORD="$SEED_PASSWORD" bash "$ROOT/backend/scripts/db/seed"

  log 'starting the stack'
  main_compose_up -d --wait --wait-timeout "$HEALTH_TIMEOUT_S" "${RUN_SERVICES[@]}"
  wait_healthy
  restart_optional_profiles
  if [[ $PURGE -eq 1 ]]; then purge_evidence; fi
  log 'demo data reset and reseeded. Existing sign-in sessions are gone because the database was replaced.'
}

# Parsed completely before running, so nothing re-reads this file while the repository changes underneath.
main "$@"
exit $?
