NODE_ENV=development
PUBLIC_PORT=8080
POSTGRES_HOST_PORT=55432
# Set C48_IMAGE_SOURCE=registry and C48_IMAGE_NAMESPACE/C48_IMAGE_TAG to pull published API images.
C48_IMAGE_SOURCE=local
C48_IMAGE_NAMESPACE=c48
C48_IMAGE_TAG=local
POSTGRES_PASSWORD=replace-with-url-safe-random-value
POSTGRES_MAX_CONNECTIONS=140
POSTGRES_SHARED_BUFFERS=256MB
IDENTITY_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
IDENTITY_APP_PASSWORD=replace-with-url-safe-random-value
RESPONSE_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
RESPONSE_APP_PASSWORD=replace-with-url-safe-random-value
LOGISTICS_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
LOGISTICS_APP_PASSWORD=replace-with-url-safe-random-value
IDENTITY_DB_POOL_MAX=20
RESPONSE_DB_POOL_MAX=30
LOGISTICS_DB_POOL_MAX=20
JWT_ISSUER=https://c48.invalid
JWT_AUDIENCE=c48-api
JWT_PRIVATE_KEY=base64-encoded-private-key
JWT_PUBLIC_KEY=base64-encoded-public-key
WEB_ALLOWED_ORIGINS=http://localhost:8080
SECRET_HASH_PEPPER_AUTH_V1=replace-with-random-value
SECRET_HASH_PEPPER_AUTH_CURRENT=v1
IDENTITY_SERVICE_CLIENT_ID=c48-identity
IDENTITY_SERVICE_CLIENT_SECRET=replace-with-random-value
RESPONSE_SERVICE_CLIENT_ID=c48-response
RESPONSE_SERVICE_CLIENT_SECRET=replace-with-random-value
LOGISTICS_SERVICE_CLIENT_ID=c48-logistics
LOGISTICS_SERVICE_CLIENT_SECRET=replace-with-random-value
IDENTITY_BASE_URL=http://identity-api:3001
RESPONSE_BASE_URL=http://response-api:3002
LOGISTICS_BASE_URL=http://logistics-api:3003
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:8080
S3_RESPONSE_ACCESS_KEY=c48-response-local
S3_RESPONSE_SECRET_KEY=replace-with-random-value
S3_LOGISTICS_ACCESS_KEY=c48-logistics-local
S3_LOGISTICS_SECRET_KEY=replace-with-random-value
S3_RESPONSE_BUCKET=c48-response-evidence
S3_LOGISTICS_BUCKET=c48-logistics-evidence
MINIO_ROOT_USER=c48-minio-local
MINIO_ROOT_PASSWORD=replace-with-url-safe-random-value
AISTOR_LICENSE_PATH=/absolute/path/to/minio.license
SEED_PASSWORD=replace-with-a-local-demo-password
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
SOS_SOFT_LIMIT_PER_IP=30
SOS_HARD_LIMIT_PER_IP=300
SOS_GLOBAL_PER_MIN=300
PROXY_OPEN_CAP=3
PROXY_DAILY_SOFT_LIMIT=10
VERIFY_OVERDUE_MINUTES=15
OFFER_OVERDUE_MINUTES=10
TEAM_POSITION_FRESH_MINUTES=30
TEAM_SEARCH_RADIUS_M=10000
TEAM_BAND_TOLERANCE_M=2000
TEAM_BAND_TOLERANCE_P2_M=500
TEAM_BAND_TOLERANCE_P1_M=0
SIGNED_URL_TTL_S=60
SCHEDULER_ENABLED=true
# Optional recovery-only opt-in; SCHEDULER_ENABLED=true still enables all scheduled jobs.
RESOLUTION_RECOVERY_ENABLED=false
INTROSPECT_TIMEOUT_MS=500
SECRET_HASH_PEPPER_SOS=replace-with-at-least-32-random-characters
SECRET_HASH_PEPPER_DONATION=replace-with-random-value
DEMO_INTAKE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
