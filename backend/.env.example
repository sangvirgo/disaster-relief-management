COMPOSE_FILE=infra/compose.yaml
NODE_ENV=development
PUBLIC_PORT=8080
POSTGRES_HOST_PORT=55432
# Set C48_IMAGE_SOURCE=registry and C48_IMAGE_NAMESPACE/C48_IMAGE_TAG to pull published API images.
C48_IMAGE_SOURCE=local
C48_IMAGE_NAMESPACE=reliva
C48_IMAGE_TAG=latest
POSTGRES_PASSWORD=replace-with-url-safe-random-value
POSTGRES_MAX_CONNECTIONS=140
POSTGRES_SHARED_BUFFERS=256MB
IDENTITY_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
IDENTITY_APP_PASSWORD=replace-with-url-safe-random-value
RESPONSE_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
RESPONSE_APP_PASSWORD=replace-with-url-safe-random-value
LOGISTICS_MIGRATOR_PASSWORD=replace-with-url-safe-random-value
LOGISTICS_APP_PASSWORD=replace-with-url-safe-random-value
IDENTITY_DB_POOL_MAX=20
RESPONSE_DB_POOL_MAX=30
LOGISTICS_DB_POOL_MAX=20
JWT_ISSUER=https://c48.invalid
JWT_AUDIENCE=c48-api
JWT_PRIVATE_KEY=base64-encoded-private-key
JWT_PUBLIC_KEY=base64-encoded-public-key
WEB_ALLOWED_ORIGINS=http://localhost:8080
SECRET_HASH_PEPPER_AUTH_V1=replace-with-random-value
SECRET_HASH_PEPPER_AUTH_CURRENT=v1
EMAIL_OTP_PEPPER=replace-with-at-least-32-random-characters
IDENTITY_EMAIL_SMTP_HOST=
IDENTITY_EMAIL_SMTP_PORT=587
IDENTITY_EMAIL_SMTP_SECURE=false
IDENTITY_EMAIL_SMTP_USER=
IDENTITY_EMAIL_SMTP_PASSWORD=
IDENTITY_EMAIL_FROM=
GOOGLE_CLIENT_IDS=
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_MAPS_API_KEY=
IDENTITY_SERVICE_CLIENT_ID=c48-identity
IDENTITY_SERVICE_CLIENT_SECRET=replace-with-random-value
RESPONSE_SERVICE_CLIENT_ID=c48-response
RESPONSE_SERVICE_CLIENT_SECRET=replace-with-random-value
LOGISTICS_SERVICE_CLIENT_ID=c48-logistics
LOGISTICS_SERVICE_CLIENT_SECRET=replace-with-random-value
IDENTITY_BASE_URL=http://identity-api:3001
RESPONSE_BASE_URL=http://response-api:3002
LOGISTICS_BASE_URL=http://logistics-api:3003
S3_ENDPOINT=http://minio:9000
# SigV4 signing region. Keep us-east-1 for MinIO; on AWS use the bucket region (for example ap-southeast-2).
S3_REGION=us-east-1
# Public origin embedded in signed evidence links. Match the LAN/tunnel origin
# configured in mobile/.env; loopback only works when the viewer is this host.
S3_PUBLIC_ENDPOINT=http://10.251.22.32:8080
S3_RESPONSE_ACCESS_KEY=c48-response-local
S3_RESPONSE_SECRET_KEY=replace-with-random-value
S3_LOGISTICS_ACCESS_KEY=c48-logistics-local
S3_LOGISTICS_SECRET_KEY=replace-with-random-value
S3_RESPONSE_BUCKET=c48-response-evidence
S3_LOGISTICS_BUCKET=c48-logistics-evidence
# Local S3 transport for authenticated host backups (existing MinIO service only).
MINIO_BACKUP_HOST_PORT=59500
MINIO_ROOT_USER=c48-minio-local
MINIO_ROOT_PASSWORD=replace-with-url-safe-random-value
SEED_PASSWORD=replace-with-a-local-demo-password
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
# SOS per minute from one client (IPv4 address or IPv6 /64): above SOFT the SOS is kept but held for review,
# above HARD Nginx answers 429 with the 113/114/115 hotline message. There is no system-wide cap: a disaster surge
# is real traffic, so the SosIntakeSurge alert reports it instead.
SOS_SOFT_LIMIT_PER_IP=30
SOS_HARD_LIMIT_PER_IP=300
# SOS per minute from one reporter phone before the next one is held for review.
SOS_SOFT_LIMIT_PER_PHONE=5
PROXY_OPEN_CAP=3
PROXY_DAILY_SOFT_LIMIT=10
VERIFY_OVERDUE_MINUTES=15
OFFER_OVERDUE_MINUTES=10
TEAM_POSITION_FRESH_MINUTES=30
TEAM_SEARCH_RADIUS_M=10000
TEAM_BAND_TOLERANCE_M=2000
TEAM_BAND_TOLERANCE_P2_M=500
TEAM_BAND_TOLERANCE_P1_M=0
SIGNED_URL_TTL_S=60
# Identity reset-email dispatch and registration cleanup are independent of Response/Logistics workers.
IDENTITY_SCHEDULER_ENABLED=true
SCHEDULER_ENABLED=true
# Logistics supply-gap recomputation (every 15 minutes). Set to false to disable; any other value fails startup.
C48_SUPPLY_GAP_JOB_ENABLED=true
# Logistics pickup-ticket expiry sweep (every 10 minutes). Set to false to disable; any other value fails startup.
C48_PICKUP_TICKET_JOB_ENABLED=true
# Logistics need-extraction sweep (every 5 minutes): turns verified relief requests into ESTIMATED need lines. Set to false to disable; any other value fails startup.
C48_NEED_EXTRACTION_JOB_ENABLED=true
# Controls non-Gemini scheduled tasks. Gemini uses its own worker flag below.
RESOLUTION_RECOVERY_ENABLED=false
INTROSPECT_TIMEOUT_MS=500
SECRET_HASH_PEPPER_SOS=replace-with-at-least-32-random-characters
SECRET_HASH_PEPPER_DONATION=replace-with-a-distinct-32-plus-char-pepper
# JSON array, tried in order when a key is invalid, rate-limited, or the provider is temporarily unavailable.
# Use keys from separate Google Cloud projects if fallback should cover project-level quota limits.
GEMINI_API_KEYS=[]
# Legacy single-key fallback. GEMINI_API_KEYS takes precedence when it contains keys.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Second model tried with the same keys when the primary model fails (quota is counted per model). Empty disables it.
GEMINI_BACKUP_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_RETRIES=1
# Gemini calls per America/Los_Angeles day, counted separately by Response and Logistics. Above it, AI work waits
# for the next day (coordinators keep working without it). 0 removes the cap; size it to the paid budget.
GEMINI_DAILY_CALL_LIMIT=2000
# Opt in only when historical imported/open SOS records require AI evaluation.
GEMINI_BACKFILL_OPEN_REQUESTS=false

# Local AI fallback (Compose profile ai-fallback): an Ollama model answers only when Gemini fails or is slow.
# `release` starts it and pulls OLLAMA_MODEL only when C48_AI_FALLBACK=on. Leave OLLAMA_BASE_URL empty to disable.
# Results are saved with the fallback model name and labelled in the coordinator view; a coordinator still reviews them.
C48_AI_FALLBACK=off
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3.5:0.8b-q8_0
# Per call. A 0.8B model on 2 vCPU needs about 20-40 s for one SOS.
OLLAMA_TIMEOUT_MS=90000
OLLAMA_NUM_CTX=4096
# Start the fallback this long after Gemini if Gemini has not answered yet (0 = start both at the same time).
# A Gemini failure starts it at once. A Gemini success always wins and stops the fallback.
AI_FALLBACK_HEDGE_MS=3000
# A queued SOS whose earlier attempts already failed this many times skips Gemini and goes straight to the fallback.
AI_FALLBACK_AFTER_FAILURES=1

# Monitoring: Prometheus, Grafana, Alertmanager, node_exporter and postgres_exporter (Compose profile observability).
# `release` starts them only when C48_OBSERVABILITY=on. Type the secrets by hand; never paste them into chats.
C48_OBSERVABILITY=off
C48_MONITOR_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_PORT=3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
C48_METRICS_DIR=/var/lib/c48/metrics
