        <mxCell id="note0" value="Exactly one outcome: VERIFIED (with basis), REJECTED (reason) or DUPLICATE (canonical)." style="text;html=0;fontSize=13;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="624" width="1320" height="22" as="geometry" /></mxCell>
