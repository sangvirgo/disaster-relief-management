<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-10-19T12:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device"><diagram id="logistics-handoff" name="ERD vật lý — Logistics: phân phối và bàn giao"><mxGraphModel dx="1646" dy="1026" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1646" pageHeight="1026" math="0" shadow="0"><root><mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id="2" value="ERD vật lý — Logistics: phân phối và bàn giao" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="48" y="20" width="1550" height="34" as="geometry"/></mxCell><mxCell id="3" value="Phiếu phân phối, dòng hàng, bàn giao, đối soát và sổ biến động kho" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="48" y="55" width="1550" height="24" as="geometry"/></mxCell><mxCell id="grp0" value="Bảng cùng service ở trang khác" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="48" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp1" value="Phiếu phân phối" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="443" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp2" value="Bàn giao và đối soát" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="838" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp3" value="Điều chỉnh và sổ kho" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="1233" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="footnote" value="Ký hiệu: PK khóa chính · FK khóa ngoại SQL · FK? nullable · UK duy nhất · UK* thuộc khóa duy nhất tổ hợp · REF ID tham chiếu không có FK. FK đồng thời là PK/UK giới hạn tối đa một bản ghi con; FK thường cho phép nhiều bản ghi con. Các khóa ngoại tới kho, hàng hóa, cam kết và biên nhận được nối bằng ô tham chiếu tới trang sở hữu bảng đó. Các user_id và campaign_id không có FK liên service." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#36465C;" vertex="1" parent="1"><mxGeometry x="48" y="950" width="1550" height="60" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_distribution_line" target="n_item"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_distribution_line" target="n_distribution"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_distribution_line" target="n_commitment"><mxGeometry relati