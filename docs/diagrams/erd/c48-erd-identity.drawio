try x="1233" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="footnote" value="Ký hiệu: PK khóa chính · FK khóa ngoại SQL · FK? nullable · UK duy nhất · UK* thuộc khóa duy nhất tổ hợp · REF ID tham chiếu không có FK. FK đồng thời là PK/UK giới hạn tối đa một bản ghi con; FK thường cho phép nhiều bản ghi con. Role và permission là danh mục mã cố định trong ứng dụng, không phải bảng SQL. campaign_id trong role_grant là ID tham chiếu sang Response, không có khóa ngoại liên service." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#36465C;" vertex="1" parent="1"><mxGeometry x="48" y="762" width="1550" height="60" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_refresh_session" target="n_session_family"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_session_family" target="n_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7B8798;strokeWidth=1.3;fontSize=10;fontColor=#40516A;labelBackgroundColor=#F4F7FB;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_role_grant" target="n_app_user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;roun