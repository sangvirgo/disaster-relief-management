<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-10-19T12:00:00.000Z" agent="OpenAI Codex" version="24.7.17" type="device"><diagram id="response-rescue" name="ERD vật lý — Response: đội và nhiệm vụ"><mxGraphModel dx="1646" dy="1174" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1646" pageHeight="1174" math="0" shadow="0"><root><mxCell id='0'/><mxCell id='1' parent='0'/><mxCell id="2" value="ERD vật lý — Response: đội và nhiệm vụ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#172033;" vertex="1" parent="1"><mxGeometry x="48" y="20" width="1550" height="34" as="geometry"/></mxCell><mxCell id="3" value="Đội cứu hộ, thành viên, kỹ năng, vị trí, nhiệm vụ và bằng chứng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="48" y="55" width="1550" height="24" as="geometry"/></mxCell><mxCell id="grp0" value="Bảng cùng service ở trang khác" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="48" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp1" value="Năng lực" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="443" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp2" value="Đội cứu hộ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#40516A;" vertex="1" parent="1"><mxGeometry x="838" y="105" width="365" height="28" as="geometry"/></mxCell><mxCell id="grp3" value="Nhiệm vụ và bằng chứng" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontS