        <mxCell id="note1" value="Khâu tiếp nhận và thẩm định biên nhận do người khác nhau thực hiện. Phân phối cần xác nhận nhận hàng độc lập." style="text;html=0;whiteSpace=wrap;strokeColor=none;fillColor=#ffffff;align=center;fontSize=12;" vertex="1" parent="1">
