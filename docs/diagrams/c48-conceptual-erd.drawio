        <mxCell id="note0" value="1 = exactly one     0..1 = optional one     0..* = zero or many     1..* = one or many" style="text;html=0;fontSize=13;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1076" width="1700" height="24" as="geometry" /></mxCell>
        <mxCell id="note1" value="Reporter and Donor are participant roles; the Affected household is a request-scoped snapshot, never an account. A Donor needs no account; a Campaign and an SOS are independent." style="text;html=0;fontSize=13;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1104" width="1700" height="24" as="geometry" /></mxCell>
        <mxCell id="note2" value="Item lines (drive items, donation lines, relief needs, distribution lines) reference Item; roles, grants, audit and notices are cross-cutting. Cross-service links are opaque IDs. Proposed design, not implemented." style="text;html=0;fontSize=13;align=left;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1132" width="1700" height="24" as="geometry" /></mxCell>
